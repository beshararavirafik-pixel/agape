# Required for cloud accounts, plans, private storage, invitations and RSVP.
NEXT_PUBLIC_SUPABASE_URL=https://ljhihphbnxeiljeijilc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility: the existing Vercel ANON_KEY variable also accepts a publishable key.
# Set either key variable; never use a service-role or secret key here.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend authentication emails are configured in Supabase Auth > SMTP,
# not in Next.js. Host smtp.resend.com, port 465, username resend,
# password = your Resend API key, sender = an address on your verified domain.
# Current test sender: onboarding@resend.dev (only your Resend account email can receive).
# Server-only settings for partner and guest invitation emails. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Agapē <onboarding@resend.dev>"
APP_URL=http://localhost:3000/
# No SUPABASE_SERVICE_ROLE_KEY is needed by this app.
